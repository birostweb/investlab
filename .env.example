# =============================================================================
#  Variables d'environnement — Mon Investisseur IA
#  Dans Dokploy, saisis-les dans l'onglet « Environment » de ton application.
#  Ne mets JAMAIS ce fichier rempli dans un dépôt Git public.
# =============================================================================

# --- OBLIGATOIRE -------------------------------------------------------------
# Mot de passe unique pour accéder à l'application. Choisis-en un long.
APP_PASSWORD=change-moi-pour-un-mot-de-passe-long-et-unique

# --- Données de marché (gratuites) -------------------------------------------
# Ces clés restent sur le serveur : le navigateur ne les voit jamais.
# Twelve Data : cours + historiques → https://twelvedata.com/pricing (800 req/jour)
TWELVEDATA_KEY=
# Finnhub : fondamentaux des actions → https://finnhub.io/register
FINNHUB_KEY=
# Alpha Vantage : secours → https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# --- Chat en langage naturel (facultatif) ------------------------------------
# Sans cette clé, InvestAI fonctionne en mode local : il comprend tes questions
# par analyse de mots-clés et répond avec son moteur d'analyse.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Réglages ----------------------------------------------------------------
# Rafraîchissement automatique des cours, en minutes (0 = désactivé).
REFRESH_MINUTES=360
# Durée de validité de la session, en jours.
SESSION_DAYS=30
TZ=Europe/Paris

# --- Avancé ------------------------------------------------------------------
# Laisse vide : généré et persisté automatiquement dans /data.
SESSION_SECRET=
# Le serveur est derrière le reverse-proxy Traefik de Dokploy.
TRUST_PROXY=true
PORT=3000
DATA_DIR=/data
